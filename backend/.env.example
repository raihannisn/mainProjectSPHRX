# NASA Open APIs (Optional, defaults to DEMO_KEY with 30 req/hr rate-limit)
NASA_API_KEY=

# Google Gemini API for Mission Liaison Agent (Chat, Speech-to-Text, Text-to-Speech)
GEMINI_API_KEY=

# Enable experimental Gemini Live bidirectional voice streaming (true/false)
GEMINI_LIVE_DEMO_ENABLED=false
